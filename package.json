{
  "name": "realimenta",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MVP académico REAlimenta: donaciones, fotografías y solicitudes persistentes en MySQL (XAMPP)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "demo:preparar": "node scripts/prepare-presentation.mjs",
    "demo:vigente": "node scripts/prepare-live-example.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.*",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
