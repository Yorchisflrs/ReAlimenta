# Nunca agregar .env ni credenciales reales a Git.
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://realimenta:CAMBIAR_CONTRASENA@127.0.0.1:55432/realimenta
APP_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
SESSION_HOURS=8
# OSRM público: desarrollo de bajo volumen, sin tráfico en vivo ni garantía de servicio.
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
# Alternativa privada OpenRouteService. Conservar la clave solamente en backend.
ORS_API_KEY=
GEOCODING_URL=https://nominatim.openstreetmap.org
MAP_USER_AGENT=REAlimenta-academic-demo/2.0
LOGISTICS_PREPARATION_MIN=15
LOGISTICS_PICKUP_MIN=10
LOGISTICS_DELIVERY_MIN=10
LOGISTICS_SAFETY_MIN=15
LOGISTICS_GREEN_MARGIN_MIN=30
