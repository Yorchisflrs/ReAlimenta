# Nunca agregar .env ni credenciales reales a Git. Copiar como .env y completar.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
SESSION_HOURS=8
# Clave larga y aleatoria (64 caracteres hex) para firmar las cookies de sesión. Obligatoria en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# MySQL / MariaDB de XAMPP. La base "realimenta" y sus tablas ya deben existir (creadas en phpMyAdmin).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=realimenta
DB_USER=root
# En XAMPP, root no tiene contraseña por defecto; si la configuró en phpMyAdmin, escríbala aquí.
DB_PASSWORD=
DB_POOL_SIZE=10
# Carpeta de fotografías de donaciones (relativa al proyecto). Apache tiene prohibido servirla.
UPLOADS_DIR=uploads/donaciones
# Dominio reservado de las cuentas de demostración.
DEMO_EMAIL_DOMAIN=realimenta.test
# OSRM público: desarrollo de bajo volumen, sin tráfico en vivo ni garantía de servicio.
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
# Alternativa privada OpenRouteService. Conservar la clave solamente en backend.
ORS_API_KEY=
GEOCODING_URL=https://nominatim.openstreetmap.org
MAP_USER_AGENT=REAlimenta-academic-demo/2.0
LOGISTICS_PREPARATION_MIN=15
LOGISTICS_PICKUP_MIN=10
LOGISTICS_DELIVERY_MIN=10
LOGISTICS_SAFETY_MIN=15
LOGISTICS_GREEN_MARGIN_MIN=30
